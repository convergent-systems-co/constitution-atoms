{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitution-atoms.com/schemas/atom-v1.json",
  "title": "constitution-atoms v1 atom",
  "description": "A single atom in the constitution-atoms catalog. Discriminated by `type`: charter atoms capture mission/scope/values; bylaw atoms capture procedures and quorum rules; principle, mission-statement, and value-declaration atoms capture lower-level governance building blocks.",
  "type": "object",
  "required": ["schema", "type", "id", "version", "name"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://constitution-atoms.com/schemas/atom-v1.json"
    },
    "type": {
      "type": "string",
      "enum": ["charter", "bylaw", "principle", "mission-statement", "value-declaration"],
      "description": "Atom type — must match the parent directory name and a declared atomType in ATOMS.yml."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "description": "Slug that matches the filename stem. Used as the last segment of the atom URI."
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 800 },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "ISO-8601 date on which this atom takes effect."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "ratified", "amended", "superseded"],
      "description": "Lifecycle state of this atom."
    },
    "authority": {
      "type": "string",
      "description": "Organization or entity that ratified this atom."
    },
    "supersedes": {
      "description": "Atom ID this atom replaces, or null.",
      "oneOf": [{ "type": "string" }, { "type": "null" }]
    },
    "references": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Informational references (URLs or atom URIs) that informed this atom."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 60 },
      "uniqueItems": true
    },

    "charter_body": {
      "type": "object",
      "description": "Only for type=charter. Mission, vision, scope, core values, operating principles, and provisions.",
      "additionalProperties": false,
      "properties": {
        "mission": { "type": "string", "minLength": 1, "maxLength": 500 },
        "vision": { "type": "string", "maxLength": 500 },
        "scope": { "type": "string", "maxLength": 800 },
        "core_values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "operating_principles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "provisions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Numbered provisions of the charter."
        }
      }
    },

    "bylaw_body": {
      "type": "object",
      "description": "Only for type=bylaw. Procedure steps, quorum rule, voting method, and amendment procedure.",
      "additionalProperties": false,
      "properties": {
        "procedure_steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Ordered steps that constitute this bylaw's procedure."
        },
        "quorum_requirement": {
          "type": "string",
          "description": "Who or what count must be present for a decision to be valid."
        },
        "voting_method": {
          "type": "string",
          "description": "How votes are counted (majority, consensus, principal-decision, etc.)."
        },
        "amendment_procedure": {
          "type": "string",
          "description": "Reference to the bylaw or procedure governing how this bylaw is amended."
        }
      }
    },

    "principle_body": {
      "type": "object",
      "description": "Only for type=principle.",
      "additionalProperties": false,
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rationale": { "type": "string", "maxLength": 800 },
        "non_overridable": {
          "type": "boolean",
          "description": "If true, this principle cannot be relaxed by override."
        }
      }
    },

    "mission_statement_body": {
      "type": "object",
      "description": "Only for type=mission-statement.",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
        "audience": { "type": "string", "maxLength": 200 }
      }
    },

    "value_declaration_body": {
      "type": "object",
      "description": "Only for type=value-declaration.",
      "additionalProperties": false,
      "required": ["value", "definition"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 80 },
        "definition": { "type": "string", "minLength": 1, "maxLength": 500 },
        "behavioral_indicators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "charter" } } },
      "then": { "required": ["charter_body"] }
    },
    {
      "if": { "properties": { "type": { "const": "bylaw" } } },
      "then": { "required": ["bylaw_body"] }
    },
    {
      "if": { "properties": { "type": { "const": "principle" } } },
      "then": { "required": ["principle_body"] }
    },
    {
      "if": { "properties": { "type": { "const": "mission-statement" } } },
      "then": { "required": ["mission_statement_body"] }
    },
    {
      "if": { "properties": { "type": { "const": "value-declaration" } } },
      "then": { "required": ["value_declaration_body"] }
    }
  ]
}
