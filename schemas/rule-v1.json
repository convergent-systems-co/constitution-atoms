{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constitution-atoms.com/schemas/rule-v1.json",
  "title": "constitution-atoms v1 rule",
  "description": "A rule constrains how atoms and compositions can be combined. Examples: amendment-constraint, ratification-requirement, quorum-rule, supersession-rule.",
  "type": "object",
  "required": ["schema", "type", "id", "version", "name", "predicate", "effect"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "https://constitution-atoms.com/schemas/rule-v1.json" },
    "type": {
      "type": "string",
      "enum": ["amendment-constraint", "ratification-requirement", "quorum-rule", "supersession-rule"],
      "description": "Governance rule type — must match the parent directory name and constrain how constitution atoms compose."
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 60 }, "uniqueItems": true },
    "predicate": {
      "type": "object",
      "required": ["subject_ref", "condition", "value"],
      "additionalProperties": false,
      "properties": {
        "subject_ref": { "type": "string", "pattern": "^constitution-atoms://(atoms|constitutions|rules)/[a-z-]+(?:/[a-z0-9-]+)?$", "description": "URI referencing atoms, constitutions, or rules. Format: constitution-atoms://<collection>/<type>/<id>" },
        "condition": { "type": "string", "enum": ["eq", "neq", "in", "not_in", "gte", "lte", "matches"] },
        "value": {}
      }
    },
    "effect": { "type": "string", "enum": ["require", "forbid", "warn"] },
    "rationale": { "type": "string", "maxLength": 500 }
  }
}
